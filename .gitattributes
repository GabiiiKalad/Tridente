###############################################################################
# Unity - Archivos de texto y merges
###############################################################################

# Forzar finales de línea LF para código y metadatos
*.cs text eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Evitar fusiones automáticas ruidosas en escenas y prefabs (Merge Drivers de Unity)
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf

###############################################################################
# Git LFS - Archivos binarios y de gran tamaño
###############################################################################

